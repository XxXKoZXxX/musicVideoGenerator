# Astraea AI Music Video Studio Environment Configuration
PORT=3220
BROWSER=none

# Video Server Port
VIDEO_PORT=4000

# fal.ai API Key for AI Video Generation (Kling, Luma Dream, Runway Gen-3, MiniMax, Stable Video)
# Sign up and get your key at https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# Anthropic Claude 3 Opus / Sonnet API Key (for Directorial Storyboard & Agent chat)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Firebase Firestore Cloud Sync Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
