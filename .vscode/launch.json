{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "expo",
            "request": "attach",
            "name": "Debug Expo app",
            "projectRoot": "${workspaceFolder}",
            "bundlerPort": "8081",
            "bundlerHost": "127.0.0.1"
        },
        {
            "name": "Electron Main",
            "program": "${workspaceFolder}/main.js",
            "request": "launch",
            "runtimeExecutable": "electron",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "name": "Launch Extension",
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm",
            "request": "launch",
            "type": "extensionHost"
        },
        {
            "name": "Electron Main",
            "program": "${workspaceFolder}/main.js",
            "request": "launch",
            "runtimeExecutable": "electron",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run electron",
            "runtimeExecutable": "electron",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run electron",
            "runtimeExecutable": "electron",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run electron",
            "runtimeExecutable": "electron",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "console": "integratedTerminal",
            "args": [
                "-Xfrozen_modules=off"
            ]
        },
        {
            "name": "Attach to Flask app in Docker",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost", // or the Docker host IP
                "port": 5612 // must match the port debugpy is listening on
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}", // Path to your code on the host machine
                    "remoteRoot": "/app"
                    // Path to your code in the Docker container
                }
            ]
        },
        {
            "name": "Run Script: start",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "args": [
                "run",
                "start"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}